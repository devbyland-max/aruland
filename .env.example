# Shared / server (copy to server/.env)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/stitchbear?schema=public
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5173
PORT=5000
NODE_ENV=development
BCRYPT_ROUNDS=12

# Optional seed admin
ADMIN_EMAIL=admin@stitchbear.com
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=StitchBear Admin

# COD / WhatsApp orders
ORDER_WHATSAPP_PHONE=355689001257
FREE_SHIPPING_FROM=5000
SHIPPING_FEE=300

# Stripe (optional / unused for COD)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
